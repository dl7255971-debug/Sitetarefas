# Exemplo de variáveis de ambiente para o TaskFlow
# Copie este arquivo para um novo arquivo chamado `.env` e preencha as chaves:

# Chave da API do Groq (obtenha em https://console.groq.com/home)
VITE_GROQ_API_KEY=sua_chave_aqui

# Configurações do Supabase (caso queira apontar para sua própria instância)
# VITE_SUPABASE_URL=sua_url_aqui
# VITE_SUPABASE_ANON_KEY=sua_chave_anonima_aqui
